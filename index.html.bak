    <!-- Hero Section -->
    <div id="scene-3d" class="scene-3d">
        <header class="hero">
            <div id="particles-js" class="particles-container"></div>
            <div class="container hero-content reveal">
                <h1><span data-i18n="hero_hi">Bonjour, je suis</span> <br><span class="typed-text"></span><span class="cursor">&nbsp;</span></h1>
                <p data-i18n="hero_subtitle">Chef de projet IT & Développeur Back-end. Solutions métiers ERP/CRM, automatisation, reporting, data et applications internes.</p>
                <p class="availability" data-i18n="availability">Disponible pour des missions de pilotage IT, CRM/ERP, data et automatisation.</p>
                <div class="hero-btns">
                    <a href="#projects" class="btn btn-primary" data-i18n="hero_btn_projects">Explorer mes réalisations</a>
                    <a href="#contact" class="btn btn-outline" data-i18n="hero_btn_contact">Collaborer ensemble</a>
                    <a href="Profile.pdf" class="btn btn-quiet" target="_blank" rel="noopener" data-i18n="cv_btn">CV PDF</a>
                </div>
                <aside class="hero-proof glass reveal" aria-label="Preuves de valeur">
                    <div class="hero-proof-topline"><span class="status-dot"></span><span data-i18n="hero_proof_status">Disponible pour de nouveaux projets</span></div>
                    <div class="hero-proof-heading"><span data-i18n="hero_proof_label">Tableau de bord</span><strong>2025—26</strong></div>
                    <div class="hero-proof-grid">
                        <div><strong>17+</strong><span data-i18n="hero_proof_projects">projets livrés</span></div>
                        <div><strong>8+</strong><span data-i18n="hero_proof_years">ans d’expérience</span></div>
                        <div><strong>360°</strong><span data-i18n="hero_proof_scope">du cadrage à la prod</span></div>
                        <div><strong>QA</strong><span data-i18n="hero_proof_quality">qualité intégrée</span></div>
                    </div>
                    <div class="hero-proof-stack"><span>ERP / CRM</span><span>DATA</span><span>BACK-END</span><span>AGILE</span></div>
                    <div class="hero-proof-note"><i class="fas fa-arrow-trend-up" aria-hidden="true"></i><span data-i18n="hero_proof_note">Des systèmes utiles, mesurables et maintenables.</span></div>
                </aside>
            </div>
        </header>

        <main id="main-content">
            <!-- Methodology Section -->
            <section id="methodology" class="section" style="background: var(--bg-primary);">
                <div class="container">
                    <div class="section-header reveal">
                        <h2 data-i18n="metho_title">Ma Méthodologie</h2>
                        <div class="underline"></div>
                    </div>
                    <div class="glass methodology-card reveal" style="padding: 2.5rem; text-align: center;">
                        <p style="font-size: 1.2rem; line-height: 1.6; max-width: 800px; margin: 0 auto;">
                            <span data-i18n="metho_intro_1">Je ne code pas seulement des fonctionnalités, je construis des systèmes durables.</span>
                            <span data-i18n="metho_intro_2">Chaque projet est ancré dans une</span> <strong data-i18n="metho_intro_3">architecture conteneurisée</strong>,
                            <span data-i18n="metho_intro_4">protégé par une</span> <strong data-i18n="metho_intro_5">suite de tests automatisés</strong> (Playwright, PHPUnit),
                            <span data-i18n="metho_intro_6">et conçu pour une maintenabilité et une évolutivité à long terme.</span>
                        </p>
                        <div style="display: flex; justify-content: center; gap: 2rem; margin-top: 2rem; flex-wrap: wrap;">
                            <div style="padding: 1rem;"><i class="fas fa-docker fa-2x"></i><p data-i18n="metho_item_1">Conteneurisation</p></div>
                            <div style="padding: 1rem;"><i class="fas fa-check-double fa-2x"></i><p data-i18n="metho_item_2">Tests Automatisés</p></div>
                            <div style="padding: 1rem;"><i class="fas fa-sync-alt fa-2x"></i><p data-i18n="metho_item_3">CI/CD & Déploiement</p></div>
                            <div style="padding: 1rem;"><i class="fas fa-code-branch fa-2x"></i><p data-i18n="metho_item_4">Clean Architecture</p></div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Services Section -->
            <section id="services" class="section services-section">
                <div class="container">
                    <div class="section-header reveal">
                        <span class="eyebrow" data-i18n="services_eyebrow">Ce que j’apporte</span>
                        <h2 data-i18n="services_title">Un partenaire technique orienté résultat</h2>
                        <p class="section-lead" data-i18n="services_lead">Du besoin métier à la mise en production, je réduis la complexité et je rends les décisions plus simples.</p>
                        <div class="underline"></div>
                    </div>
                    <div class="services-grid reveal">
                        <article class="service-card"><div class="service-icon"><i class="fas fa-compass-drafting" aria-hidden="true"></i></div><span class="service-index">01</span><h3 data-i18n="service_1_title">Cadrer & prioriser</h3><p data-i18n="service_1_text">Clarifier les objectifs, les workflows et les critères de succès avant d’engager le développement.</p><a href="#contact" class="service-link"><span data-i18n="service_link_1">Discuter du besoin</span> <i class="fas fa-arrow-right" aria-hidden="true"></i></a></article>
                        <article class="service-card"><div class="service-icon"><i class="fas fa-layer-group" aria-hidden="true"></i></div><span class="service-index">02</span><h3 data-i18n="service_2_title">Construire le socle</h3><p data-i18n="service_2_text">Concevoir des applications ERP/CRM, des API et des pipelines data robustes, documentés et évolutifs.</p><a href="#projects" class="service-link"><span data-i18n="service_link_2">Voir les réalisations</span> <i class="fas fa-arrow-right" aria-hidden="true"></i></a></article>
                        <article class="service-card"><div class="service-icon"><i class="fas fa-chart-line" aria-hidden="true"></i></div><span class="service-index">03</span><h3 data-i18n="service_3_title">Piloter l’impact</h3><p data-i18n="service_3_text">Suivre la qualité, les livrables et l’adoption pour transformer un projet technique en valeur métier.</p><a href="#contact" class="service-link"><span data-i18n="service_link_3">Parlons de vos enjeux</span> <i class="fas fa-arrow-right" aria-hidden="true"></i></a></article>
                    </div>
                </div>
            </section>

            <!-- About Section -->
            <section id="about" class="section">
                <div class="container">
                    <div class="section-header reveal">
                        <h2 data-i18n="about_title">Mon Profil</h2>
                        <div class="underline"></div>
                    </div>
                    <div class="glass about-card reveal" style="padding: 2.5rem; display: flex; gap: 3rem; align-items: center; flex-wrap: wrap;">
                        <div style="flex: 1; min-width: 300px;">
                            <p style="font-size: 1.1rem; margin-bottom: 1.5rem;" data-i18n="about_p1">Chef de projet IT et développeur back-end, je conçois et pilote des solutions numériques adaptées aux besoins métiers : ERP, CRM, automatisation, reporting, data et applications internes.</p>
                            <p style="font-size: 1.1rem;" data-i18n="about_p2">Mon expérience couvre le développement PHP/Symfony, Java, C#, React/Ionic, la modélisation de données, les requêtes SQL complexes, les traitements ETL avec SSIS, ainsi que la création de tableaux de bord avec Power Query et DAX.</p>
                        </div>
                        <div style="width: 250px; height: 250px; border-radius: 50%; overflow: hidden; border: 5px solid var(--accent); margin: 0 auto;">
                            <img src="image/herizo.png" alt="Herizo Randrianaina, chef de projet IT et développeur back-end" width="250" height="250" loading="lazy" decoding="async" style="width: 100%; height: 100%; object-fit: cover;">
                        </div>
                    </div>
                </div>
            </section>

            <!-- Skills Section -->
            <section id="skills" class="section" style="background: var(--bg-secondary);">
                <div class="container">
                    <div class="section-header reveal">
                        <h2 data-i18n="skills_title">Expertise Technique</h2>
                        <div class="underline"></div>
                    </div>
                    
                    <div class="skills-container reveal">
                        <div class="skill-category">
                            <h3 data-i18n="skills_dev">Gestion de projet & Back-end</h3>
                            <div class="skill-list">
                                <div class="skill-item"><i class="fas fa-tasks"></i> <span data-i18n="skill_pm">Gestion de projets techniques & Agile</span></div>
                                <div class="skill-item"><i class="fab fa-php"></i> PHP/Symfony, Java, C#</div>
                                <div class="skill-item"><i class="fab fa-react"></i> React, Ionic, JHipster</div>
                            </div>
                        </div>
                        <div class="skill-category">
                            <h3 data-i18n="skills_db">Data & BI Expert</h3>
                            <div class="skill-list">
                                <div class="skill-item"><i class="fas fa-database"></i> SQL Server (SSMS), T-SQL</div>
                                <div class="skill-item"><i class="fas fa-project-diagram"></i> Pipelines ETL (SSIS/Python)</div>
                                <div class="skill-item"><i class="fas fa-chart-line"></i> Power BI, DAX, Excel avancé</div>
                            </div>
                        </div>
                        <div class="skill-category">
                            <h3 data-i18n="skills_infra">Qualité & Infrastructure</h3>
                            <div class="skill-list">
                                <div class="skill-item"><i class="fas fa-vial"></i> QA & Tests (Playwright, JUnit)</div>
                                <div class="skill-item"><i class="fas fa-building"></i> ERP 8sens (Expert)</div>
                                <div class="skill-item"><i class="fas fa-server"></i> Docker, Proxmox, admin serveur</div>
                            </div>
                        </div>
                    </div>

                    <div class="stats-grid reveal">
                        <div class="stat-item">
                            <div class="stat-circle" data-target="17" data-suffix="+">17+</div>
                            <p data-i18n="stat_projects">Projets Livrés</p>
                        </div>
                        <div class="stat-item">
                            <div class="stat-circle" data-target="8" data-suffix="+">8+</div>
                            <p data-i18n="stat_years">Ans d'expérience</p>
                        </div>
                        <div class="stat-item">
                            <div class="stat-circle" data-target="3" data-suffix="">3</div>
                            <p data-i18n="stat_domains">Domaines clés</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Projects Section -->
            <section id="projects" class="section">
                <div class="container">
                    <div class="section-header reveal">
                        <h2 data-i18n="projects_title">Projets Phares</h2>
                        <div class="underline"></div>
                    </div>

                    <div class="case-studies reveal" aria-label="Études de cas sélectionnées">
                        <button type="button" class="case-study-card" onclick="openModal('proj2')">
                            <span class="case-study-type" data-i18n="case_crm_type">CRM multi-portails</span>
                            <strong data-i18n="case_crm_title">Unifier les opérations commerciales</strong>
                            <span data-i18n="case_crm_text">Laravel, Filament, workflows, imports et gestion fine des droits.</span>
                            <span class="case-study-meta"><i class="fas fa-layer-group" aria-hidden="true"></i><span data-i18n="case_crm_meta">Laravel · Filament · RBAC</span></span>
                        </button>
                        <button type="button" class="case-study-card" onclick="openModal('proj9')">
                            <span class="case-study-type" data-i18n="case_data_type">Data & automatisation</span>
                            <strong data-i18n="case_data_title">Qualifier des données entreprises</strong>
                            <span data-i18n="case_data_text">Pipeline de collecte, enrichissement et exports prêts à exploiter.</span>
                            <span class="case-study-meta"><i class="fas fa-database" aria-hidden="true"></i><span data-i18n="case_data_meta">Python · API · Docker</span></span>
                        </button>
                        <button type="button" class="case-study-card" onclick="openModal('proj19')">
                            <span class="case-study-type" data-i18n="case_ai_type">IA conversationnelle</span>
