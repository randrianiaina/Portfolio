            contact: "menja.herizo@gmail.com | +261 34 97 26 70 | Antananarivo, Madagascar",
            links: "linkedin.com/in/herizo-randrianaina | github.com/herizo-r",
            summary: "Chef de Projet IT, Lead Back-end et Analyste de Données avec plus de 8 ans d'expérience. Double expertise unique combinant le pilotage de projets digitaux et de développements logiciels complexes (Laravel, Node.js, React, Flutter) avec l'analyse décisionnelle avancée (SQL Server, SSIS, Power BI, Excel). Expert de l'ERP 8sens et des architectures d'intégration, je sécurise chaque déploiement de bout en bout grâce à une conteneurisation stricte (Docker) et une automatisation rigoureuse de l'assurance qualité (Playwright, JUnit, PHPUnit).",
            skills: [
                { category: "Gestion de Projet & Méthodologie", items: ["Agile/Scrum", "Cadrage", "Cahiers des Charges", "Planification", "Recette Utilisateur", "Coordination d'Équipe", "Management Offshore"] },
                { category: "Développement Logiciel", items: ["PHP (Symfony, Laravel 12 + Filament)", "Node.js", "Java", "C#", "TypeScript/React", "Flutter (Mobile)", "JHipster"] },
                { category: "Data & Business Intelligence", items: ["SQL Server (SSMS)", "Requêtes Complexes & Modélisation", "Pipelines ETL (SSIS, Python)", "Power Query", "DAX", "Power BI", "Excel Avancé"] },
                { category: "Systèmes, CMS & Infrastructure", items: ["ERP 8sens", "WordPress (Développement A à Z, SEO, Performances, Sécurité)", "Docker", "Proxmox", "GLPI"] },
                { category: "Qualité & Tests (QA)", items: ["Tests E2E (Playwright)", "Tests Unitaires (JUnit, PHPUnit)"] }
            ],
            experience: [
                {
                    role: "IT Project Manager — Offshore",
                    date: "Mars 2025 – Présent",
                    location: "Antananarivo, Madagascar",
                    details: [
                        "Cadrage, planification et pilotage de projets digitaux en méthode Agile/Scrum pour des clients internationaux.",
                        "Coordination d'équipes pluridisciplinaires (développeurs, graphistes, marketing) et suivi rigoureux des KPIs et des livrables.",
                        "Conception, développement, personnalisation avancée de thèmes/plugins et maintenance de sites WordPress de A à Z.",
                        "Garant de la performance globale, de la sécurité applicative, du référencement technique (SEO) et du respect strict des délais de livraison."
                    ]
                },
                {
                    role: "Analyste Programmeur & Business Analyst — Société de Distribution",
                    date: "Janvier 2024 – Février 2025",
                    location: "Antananarivo, Madagascar",
                    details: [
                        "Collecte, consolidation et interprétation de larges volumes de données opérationnelles pour l'aide à la décision de la Direction.",
                        "Modélisation de données complexes sous SQL Server (SSMS) et implémentation de flux d'intégration de données (Pipelines ETL) avec SSIS et Python.",
                        "Création et automatisation de tableaux de bord de pilotage décisionnels et rapports KPI sous Power BI et Power Query (formules DAX).",
                        "Administration opérationnelle et développement spécifique sur l'ERP 8sens, détection des écarts de performance sur les déploiements et garantie de la qualité et fiabilité des données."
                    ]
                },
                {
                    role: "Développeur Chef de Projet — Software Overseas Academy",
                    date: "Avril 2023 – Novembre 2023",
                    location: "Antananarivo, Madagascar",
                    details: [
                        "Lead Developer sur des solutions multi-technologies (Symfony, C#, JHipster) et pilotage de l'équipe en méthode Agile.",
                        "Conception d'architectures d'intégration et pilotage de migrations API critiques avec validation systématique de la parité de service.",
                        "Conteneurisation des applications (Docker / Docker Compose) et mise en œuvre d'une suite de tests automatisés (Playwright, JUnit) garantissant zéro régression.",
                        "Administration système des infrastructures d'hébergement locales et distantes (Proxmox, GLPI)."
                    ]
                },
                {
                    role: "Opérateur Sénior & Support Qualité — Oworkers / Outsourcia",
                    date: "2017 – 2022",
                    location: "Antananarivo, Madagascar",
                    details: [
                        "Traitement de données de production, contrôle qualité et validation fonctionnelle front-office pour des comptes clients majeurs (Cdiscount, Foxit)."
                    ]
                }
            ],
            education: [
                { degree: "Master 1 en Base de Données & Génie Logiciel", school: "CNTEMAD Madagascar", year: "2024" },
                { degree: "Concepteur Développeur d'Applications", school: "Inclusiv Academy", year: "2022 – 2023" },
                { degree: "Licence (Bacc+3) en Informatique : Réseaux & Systèmes", school: "CNTEMAD Madagascar", year: "2012 – 2015" }
            ]
        },
        en: {
            name: "Herizo Randrianaina",
            title: "IT Project Manager & Lead Back-End | Analyste Programmer & Business Analyst",
            contact: "menja.herizo@gmail.com | +261 34 97 26 70 | Antananarivo, Madagascar",
            links: "linkedin.com/in/herizo-randrianaina | github.com/herizo-r",
            summary: "IT Project Manager, Lead Back-End Developer, and Data Analyst with over 8 years of experience. Possesses a unique dual expertise combining digital project coordination and complex software development (Laravel, Node.js, React, Flutter) with advanced business intelligence (SQL Server, SSIS, Power BI, Excel). Highly specialized in 8sens ERP and system integration architectures, securing end-to-end deployments through strict containerization (Docker) and rigorous automated quality assurance (Playwright, JUnit, PHPUnit).",
            skills: [
                { category: "Project Management & Methodology", items: ["Agile/Scrum", "Project Scoping", "Technical Requirement Specifications", "Timelines & Milestones", "User Acceptance Testing (UAT)", "Team Coordination", "Offshore Management"] },
                { category: "Software Development", items: ["PHP (Symfony, Laravel 12 + Filament)", "Node.js", "Java", "C#", "TypeScript/React", "Flutter (Mobile)", "JHipster"] },
                { category: "Data & Business Intelligence", items: ["SQL Server (SSMS)", "Complex Query Writing & Data Modeling", "ETL Pipelines (SSIS, Python)", "Power Query", "DAX", "Power BI", "Advanced Excel"] },
                { category: "Systems, CMS & Infrastructure", items: ["8sens ERP", "WordPress (End-to-End Development, SEO, Performance, Security)", "Docker", "Proxmox", "GLPI"] },
                { category: "Quality & Testing (QA)", items: ["E2E Testing (Playwright)", "Unit Testing (JUnit, PHPUnit)"] }
            ],
            experience: [
                {
                    role: "IT Project Manager — Offshore",
                    date: "March 2025 – Present",
                    location: "Antananarivo, Madagascar",
                    details: [
                        "Scoped, planned, and managed international digital projects using Agile/Scrum methodology.",
                        "Coordinated multidisciplinary teams (developers, graphic designers, marketing) and closely monitored project KPIs and deliverables.",
                        "Designed, developed, customized themes/plugins, and maintained WordPress websites from scratch (end-to-end).",
                        "Guaranteed overall performance, application security, technical SEO, and strict adherence to delivery deadlines."
                    ]
                },
                {
                    role: "Analyst Programmer & Business Analyst — Distribution Company",
                    date: "January 2024 – February 2025",
                    location: "Antananarivo, Madagascar",
                    details: [
                        "Collected, consolidated, and interpreted large volumes of operational business data to deliver reliable insights to executive leadership.",
                        "Modeled complex data structures under SQL Server (SSMS) and implemented robust ETL data integration pipelines using SSIS and Python.",
                        "Created and automated interactive decision-making dashboards and KPI reports using Power BI and Power Query (DAX formulas).",
                        "Provided database administration and custom development on 8sens ERP, tracked deployment performance gaps, and ensured data quality/reliability."
                    ]
                },
                {
                    role: "Project Manager & Lead Developer — Software Overseas Academy",
                    date: "April 2023 – November 2023",
                    location: "Antananarivo, Madagascar",
                    details: [
                        "Served as Lead Developer for multi-tech software solutions (Symfony, C#, JHipster) and managed the technical team using Agile methods.",
                        "Designed system integration architectures and led critical API migrations, guaranteeing 100% service parity.",
                        "Containerized software environments (Docker / Docker Compose) and implemented automated testing suites (Playwright, JUnit) achieving zero-regression releases.",
                        "Maintained local and remote hosting infrastructures (Proxmox, GLPI)."
                    ]
                },
                {
                    role: "Senior Operator & Quality Support — Oworkers / Outsourcia",
                    date: "2017 – 2022",
                    location: "Antananarivo, Madagascar",
                    details: [
                        "Processed operational data, performed quality control, and conducted front-office functional validation for key accounts (Cdiscount, Foxit)."
                    ]
                }
            ],
            education: [
                { degree: "Master 1 in Database Administration & Software Engineering", school: "CNTEMAD Madagascar", year: "2024" },
                { degree: "Software Application Designer & Developer", school: "Inclusiv Academy", year: "2022 – 2023" },
                { degree: "Bachelor's Degree (Bacc+3) in Computer Science: Networks & Systems", school: "CNTEMAD Madagascar", year: "2012 – 2015" }
            ]
        }
    };

    function generateCV() {
        // PDF generation disabled for now
        console.log('PDF generation is currently disabled');
        return;
        const lang = (typeof currentLang !== 'undefined') ? currentLang : 'fr';
        const data = cvData[lang];
        
        // Create a temporary container for the PDF content
        const container = document.createElement('div');
        container.style.padding = '40px';
        container.style.fontFamily = 'Arial, sans-serif';
        container.style.lineHeight = '1.6';
        container.style.color = '#333';
        container.style.maxWidth = '800px';
        container.style.margin = '0 auto';
        container.style.background = 'white';
        
        // Helper to create sections
        const addSection = (title, content) => {
            const section = document.createElement('div');
            section.style.marginBottom = '24px';
            section.style.pageBreakInside = 'avoid';
            
            const h2 = document.createElement('h2');
            h2.textContent = title;
            h2.style.color = '#1db954';
            h2.style.borderBottom = '2px solid #1db954';
            h2.style.paddingBottom = '4px';
            h2.style.marginBottom = '12px';
            h2.style.fontSize = '1.3rem';
            section.appendChild(h2);
            
            section.appendChild(content);
            return section;
        };
        
        // Helper for bullet lists
        const createList = (items, isBullet = true) => {
            const ul = document.createElement(isBullet ? 'ul' : 'div');
            ul.style.margin = '0';
            ul.style.paddingLeft = isBullet ? '20px' : '0';
            items.forEach(item => {
                const li = document.createElement(isBullet ? 'li' : 'div');
                li.textContent = item;
                li.style.marginBottom = '4px';
                ul.appendChild(li);
            });
            return ul;
        };
        
        // Header
        const header = document.createElement('div');
        header.style.textAlign = 'center';
        header.style.marginBottom = '24px';
        header.style.borderBottom = '1px solid #eee';
        header.style.paddingBottom = '16px';
        
        const name = document.createElement('h1');
        name.textContent = data.name;
        name.style.margin = '0 0 4px 0';
        name.style.fontSize = '2rem';
        name.style.color = '#121212';
        header.appendChild(name);
        
        const title = document.createElement('div');
        title.textContent = data.title;
        title.style.color = '#666';
        title.style.fontSize = '1rem';
        title.style.marginBottom = '8px';
        header.appendChild(title);
        
        const contact = document.createElement('div');
        contact.textContent = data.contact;
        contact.style.fontSize = '0.85rem';
        contact.style.color = '#888';
        contact.style.marginBottom = '4px';
        header.appendChild(contact);
        
        const links = document.createElement('div');
        links.textContent = data.links;
        links.style.fontSize = '0.85rem';
        links.style.color = '#888';
        header.appendChild(links);
        
        container.appendChild(header);
        
        // Summary
        const summaryDiv = document.createElement('p');
        summaryDiv.textContent = data.summary;
        summaryDiv.style.textAlign = 'justify';
        container.appendChild(addSection(lang === 'fr' ? 'Résumé Professionnel' : 'Professional Summary', summaryDiv));
        
        // Skills
        const skillsContent = document.createElement('div');
        data.skills.forEach(skill => {
            const cat = document.createElement('div');
            cat.style.marginBottom = '12px';
            const catTitle = document.createElement('strong');
            catTitle.textContent = skill.category + ' : ';
            cat.appendChild(catTitle);
            const catItems = document.createElement('span');
            catItems.textContent = skill.items.join(' • ');
            catItems.style.color = '#555';
            cat.appendChild(catItems);
            skillsContent.appendChild(cat);
        });
        container.appendChild(addSection(lang === 'fr' ? 'Compétences Techniques & Expertises' : 'Technical Skills & Expertise', skillsContent));
        
        // Experience
        const expContent = document.createElement('div');
        data.experience.forEach(exp => {
            const job = document.createElement('div');
            job.style.marginBottom = '16px';
            job.style.pageBreakInside = 'avoid';
            
            const role = document.createElement('div');
            role.innerHTML = `<strong>${exp.role}</strong> <span style="color:#888; font-weight:normal;">| ${exp.date} | ${exp.location}</span>`;
            role.style.fontSize = '1rem';
            role.style.marginBottom = '8px';
            job.appendChild(role);
            
            const list = createList(exp.details);
            job.appendChild(list);
            expContent.appendChild(job);
        });
        container.appendChild(addSection(lang === 'fr' ? 'Expériences Professionnelles' : 'Professional Experience', expContent));
        
        // Education
        const eduContent = document.createElement('div');
        data.education.forEach(edu => {
            const item = document.createElement('div');
            item.style.marginBottom = '8px';
            item.innerHTML = `<strong>${edu.degree}</strong> — ${edu.school} <span style="color:#888;">(${edu.year})</span>`;
            eduContent.appendChild(item);
        });
        container.appendChild(addSection(lang === 'fr' ? 'Formations & Diplômes' : 'Education & Degrees', eduContent));

                // Generate PDF
                const opt = {
                    margin:       0.5,
                    filename:     `CV_Herizo_Randrianaina_${lang.toUpperCase()}.pdf`,
                    image:        { type: 'jpeg', quality: 0.98 },
                    html2canvas:  { scale: 2, useCORS: true, logging: false },
                    jsPDF:        { unit: 'in', format: 'a4', orientation: 'portrait' },
                    pagebreak:    { mode: 'avoid-all', avoid: ['h2', 'div'] }
                };

                // Add container to body for rendering (invisible but in flow)
                container.style.position = 'fixed';
                container.style.left = '0';
                container.style.top = '0';
                container.style.width = '210mm';
                container.style.height = 'auto';
                container.style.opacity = '0';
                container.style.pointerEvents = 'none';
                container.style.zIndex = '-1';
                container.style.background = 'white';
                document.body.appendChild(container);

                // Force reflow
                container.offsetHeight;

                // Check library availability
                const html2pdfLib = window.html2pdf || window.html2pdfDefault || window.Html2Pdf || (typeof html2pdf !== 'undefined' ? html2pdf : null);

                if (!html2pdfLib) {
                    console.error('html2pdf library not loaded!');
                    alert('Erreur: La librairie PDF n\'a pas pu charger.\n\nSi vous ouvrez le fichier directement (file://), cela ne marchera pas.\nUtilisez http://localhost/Portfolio via Laragon.');
                    document.body.removeChild(container);
                    return;
                }

                html2pdfLib().set(opt).from(container).save().then(() => {
                    document.body.removeChild(container);
                }).catch(err => {
                    console.error('PDF generation error:', err);
                    alert('Erreur lors de la génération du PDF: ' + err.message);
                    document.body.removeChild(container);
                });
    }
    
    // Also bind the nav button
    document.addEventListener('DOMContentLoaded', () => {
        const btn = document.getElementById('cv-download-btn');
        if (btn) btn.addEventListener('click', generateCV);
    });
    
    // Expose for debugging
    window.generateCV = generateCV;
    </script>
</body>
</html>
